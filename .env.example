# Exporte no ambiente do terminal; o backend não carrega .env automaticamente.
# API local para o frontend Vite em 3002.
MAGISFORM_SERVER_HOST=127.0.0.1
MAGISFORM_SERVER_PORT=3001
MAGISFORM_SERVER_ORIGIN=http://127.0.0.1:3002
MAGISFORM_SERVER_DB_HOST=127.0.0.1
MAGISFORM_SERVER_DB_PORT=3306
MAGISFORM_SERVER_DB_NAME=magisform
MAGISFORM_SERVER_DB_USER=magisform_app
MAGISFORM_SERVER_DB_PASSWORD=preencha-a-senha-local

# Comandos explícitos de banco.
MAGISFORM_DB_HOST=127.0.0.1
MAGISFORM_DB_PORT=3306
MAGISFORM_DB_NAME=magisform
MAGISFORM_DB_USER=magisform_app
MAGISFORM_DB_PASSWORD=preencha-a-senha-local
