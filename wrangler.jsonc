{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magisform",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "magisform-piloto",
      "database_id": "c21decb3-8d00-4a4d-9340-f0511ac14e3e",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_ACCESS_TEAM_DOMAIN",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  }
}
